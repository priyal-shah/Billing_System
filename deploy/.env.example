# Copy to deploy/.env and fill in. Never commit or share the real .env.

# Public hostname. With an Elastic IP of 13.233.10.5 the free hostname is 13-233-10-5.sslip.io
SITE_ADDRESS=13-233-10-5.sslip.io
CORS_ORIGINS=https://13-233-10-5.sslip.io

# MongoDB Atlas connection string (Atlas -> Connect -> Drivers). Put the database user's password in it.
MONGO_URI=mongodb+srv://billing_app:<password>@<cluster-name>.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=billing
MONGO_DB=grocery_billing

# Long random secret for login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
REQUIRE_ADMIN_2FA=true
GUEST_EXPIRE_MINUTES=240

# AI assistant (admin chat). Leave empty to turn the feature off.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_TIMEZONE=Asia/Kolkata

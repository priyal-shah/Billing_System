MONGO_URI=mongodb://localhost:27017
MONGO_DB=grocery_billing
# Use a long random string in production: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production
# Sign-in sessions: 15-minute access cookie, renewed by a refresh cookie that lasts this many days.
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
# Admins must set up two-factor sign-in. Only turn off for local experiments.
REQUIRE_ADMIN_2FA=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI assistant (admin chat). Leave ANTHROPIC_API_KEY empty to turn the feature off.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_TIMEZONE=Asia/Kolkata
